# Banco de dados
POSTGRES_USER=gih
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gih
# Porta no host. A 5432 costuma já estar ocupada por outro Postgres na máquina;
# dentro da rede do compose o banco continua em 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://gih:troque-esta-senha@localhost:5433/gih

# API
API_PORT=8000
# Fuso do servidor. O filtro por data da trilha de auditoria usa o dia do
# relógio local — em UTC, "hoje" perderia o que aconteceu depois das 21h.
TZ=America/Recife

# Sessão. Não existe segredo de assinatura: o identificador é sorteado e o
# estado fica no servidor, então não há nada para assinar.
SESSAO_DURACAO_HORAS=8
# `Secure` exige HTTPS. Falso no ambiente local; **verdadeiro em produção**,
# senão o cookie de sessão trafega em claro.
COOKIE_SEGURO=false

# Administrador inicial, criado na primeira subida se a base não tiver nenhum.
# Deixando a senha vazia, o sistema sorteia uma e imprime no log — que é o
# recomendado. Nunca versione uma senha real aqui.
ADMIN_LOGIN=admin
ADMIN_NOME=Administrador
ADMIN_SENHA=

# Assistente (modelo de linguagem local)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Nucleo computacional
OTIMIZADOR_MODO=auto
